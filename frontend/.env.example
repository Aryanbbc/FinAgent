# Used by Next.js at build time. This endpoint is public and must be HTTPS in production.
NEXT_PUBLIC_FINAGENT_API_URL=http://127.0.0.1:8000
# Server-only Vercel variables for controlled historical experiment and AAPL
# improvement bridges.
# Never rename either to NEXT_PUBLIC_* or expose their values to browser code.
FINAGENT_API_URL=http://127.0.0.1:8000
FINAGENT_SERVER_ADMIN_API_KEY=
