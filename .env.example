# Local development defaults. Production values are documented in docs/DEPLOYMENT.md.
LIVE_TRADING_ENABLED=false
FINAGENT_ENV=development
DATABASE_URL=sqlite:///data/finagent.db
# Production: set this to the Render Internal Database URL; never commit its credentials.
API_HOST=0.0.0.0
PORT=8000
# API_PORT remains supported for backward-compatible local scripts when PORT is absent.
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000
# Backend-only credential for optional Twelve Data historical and live providers.
# Production: set this in Render; never put it in frontend environment variables.
TWELVE_DATA_API_KEY=
# Opt-in, non-executing live market intelligence. Polling remains deliberately
# conservative for Twelve Data plan limits; it never submits an order.
LIVE_MARKET_ENABLED=false
LIVE_DEFAULT_SYMBOL=AAPL
LIVE_SYMBOLS=AAPL
LIVE_INTERVAL=1min
LIVE_BUFFER_SIZE=300
LIVE_POLL_SECONDS=60
LIVE_RETENTION=500
LIVE_MAX_BACKOFF_SECONDS=900
DATA_CACHE_PATH=data/cache
REPORTS_PATH=reports
