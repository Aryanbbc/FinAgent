# Local development defaults. Production values are documented in docs/DEPLOYMENT.md.
LIVE_TRADING_ENABLED=false
FINAGENT_ENV=development
DATABASE_URL=sqlite:///data/finagent.db
# Production: set this to the Render Internal Database URL; never commit its credentials.
API_HOST=0.0.0.0
PORT=8000
# API_PORT remains supported for backward-compatible local scripts when PORT is absent.
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000
# Backend-only credential for the optional Twelve Data historical provider.
# Production: set this in Render; never put it in frontend environment variables.
TWELVE_DATA_API_KEY=
DATA_CACHE_PATH=data/cache
REPORTS_PATH=reports
